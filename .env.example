# Server port (default 3000)
PORT=3000

# Directory for JSON storage files (defaults to app root)
DATA_DIR=

# RAWG Video Games Database API key
RAWG_API_KEY=

# How many days back the fallback trending list looks (default 120). It is only used if RAWG's own trending list stops answering
TRENDING_DAYS=120

# Enforce secure cookies (true/false)
COOKIE_SECURE=false
